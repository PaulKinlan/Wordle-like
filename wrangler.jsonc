{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wordle-like",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Served at https://letterle.app (the zone is on Cloudflare; deploy keeps
  // the custom domain attached). The workers.dev address keeps working too,
  // and Previews need it.
  "routes": [{ "pattern": "letterle.app", "custom_domain": true }],
  "workers_dev": true,
  // Lets a bare `wrangler deploy` (e.g. Cloudflare Workers Builds with no
  // build command set) build first. After `vite build`, wrangler uses the
  // config the Vite plugin writes to dist/ instead.
  "build": { "command": "npx vite build" },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // The PWA built by Vite. The routes below run the Worker first; everything
    // else is a static file, with index.html as the fallback. /assets/* is on
    // the list only so a missing built file gets a 404 rather than that
    // fallback (see the end of fetch in worker/index.ts).
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/s/*", "/r/*", "/og/*", "/manifest.webmanifest", "/assets/*"]
  },
  // Keeps the private answer order (see worker/answers.ts). The Worker fills
  // it on its first request.
  "d1_databases": [{ "binding": "DB", "database_name": "wordle-like", "database_id": "5a3db60e-ca35-4c19-82d1-c73140bca102" }],
  // Multiplayer: one Durable Object per race room (worker/room.ts), with
  // SQLite-backed storage. Created on deploy; nothing to set up by hand.
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Daily reminders (worker/push.ts): every ten minutes, notify subscribers
  // whose chosen local hour has come (up to 40 a run, so 240 an hour). The VAPID keys are made by the Worker and kept
  // in D1, so there's nothing to set up (secrets can override them).
  "triggers": { "crons": ["*/10 * * * *"] },
  // Cloudflare Access in front of /dashboard and its data (worker/access.ts).
  // Both empty: the dashboard uses its key instead. ACCESS_TEAM is the Zero
  // Trust team name; ACCESS_AUD is the Access application's Audience tag.
  // Neither is a secret. Previews don't inherit these, so they keep the key.
  "vars": { "ACCESS_TEAM": "", "ACCESS_AUD": "c3e96820e55ddc9c9bd0dac7c0cc908c94d4c677bb4aee9666ce4196ffb2b1b4" },
  // Per-visitor rate limits (worker/http.ts): ordinary play, things that write
  // to the database or draw an image, and making race rooms. Counted per
  // minute, per address. Nothing to set up; the Worker runs without them too.
  "ratelimits": [
    { "name": "LIMIT_API", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "LIMIT_WRITES", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "LIMIT_ROOMS", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
  ],
  // Branch Previews (Workers Builds runs `npx wrangler preview` on branches).
  // They don't inherit the settings above. Each Preview gets its own Room
  // namespace automatically; the D1 database is a separate preview one, so
  // previews never touch the real answers or reminder subscriptions. Cron
  // triggers only run in production.
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_name": "wordle-like-preview", "database_id": "3760372f-c816-4f82-8c3f-befc08db600a" }
    ],
    "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
    "ratelimits": [
      { "name": "LIMIT_API", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
      { "name": "LIMIT_WRITES", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
      { "name": "LIMIT_ROOMS", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } }
    ]
  }
}
