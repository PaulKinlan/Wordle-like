{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wordle-like",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Served at https://letterle.app (the zone is on Cloudflare; deploy keeps
  // the custom domain attached). The workers.dev address keeps working too,
  // and Previews need it.
  "routes": [{ "pattern": "letterle.app", "custom_domain": true }],
  "workers_dev": true,
  // Lets a bare `wrangler deploy` (e.g. Cloudflare Workers Builds with no
  // build command set) build first. After `vite build`, wrangler uses the
  // config the Vite plugin writes to dist/ instead.
  "build": { "command": "npx vite build" },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // The PWA built by Vite. Only /api/* runs the Worker first; everything
    // else is a static file, with index.html as the fallback.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health", "/s/*", "/r/*", "/og/*"]
  },
  // Keeps the private answer order (see worker/answers.ts). The Worker fills
  // it on its first request.
  "d1_databases": [{ "binding": "DB", "database_name": "wordle-like", "database_id": "5a3db60e-ca35-4c19-82d1-c73140bca102" }],
  // Multiplayer: one Durable Object per race room (worker/room.ts), with
  // SQLite-backed storage. Created on deploy; nothing to set up by hand.
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Daily reminders (worker/push.ts): every hour, notify subscribers whose
  // chosen local hour has come. The VAPID keys are made by the Worker and kept
  // in D1, so there's nothing to set up (secrets can override them).
  "triggers": { "crons": ["0 * * * *"] },
  // Branch Previews (Workers Builds runs `npx wrangler preview` on branches).
  // They don't inherit the settings above. Each Preview gets its own Room
  // namespace automatically; the D1 database is a separate preview one, so
  // previews never touch the real answers or reminder subscriptions. Cron
  // triggers only run in production.
  "previews": {
    "d1_databases": [
      { "binding": "DB", "database_name": "wordle-like-preview", "database_id": "3760372f-c816-4f82-8c3f-befc08db600a" }
    ],
    "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] }
  }
}
